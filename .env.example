# Скопируйте: copy .env.example .env
# Значения учёток и паролей — только в `.env` (не в git, не в чат).
# Подъём стенда: .\scripts\dev-up.ps1  (см. docs/delivery/dev-stand.md)

ROSTENDER_BASE_URL=https://rostender.info
ROSTENDER_COOKIES_FILE=./cookies.rostender.txt
# NEXT+ СИБУР SRM (зонд: docs/discovery/sibur-srm-probe.md). Worker as-is этот файл не читает.
SIBUR_COOKIES_FILE=./cookies.sibur.txt
# NEXT+ OnlineContract (зонд: docs/discovery/onlinecontract-probe.md). Worker as-is не читает.
ONLINECONTRACT_COOKIES_FILE=./cookies.onlinecontract.txt
ONLINECONTRACT_USER=
ONLINECONTRACT_PASSWORD=
# NEXT+ Tender.Pro (зонд: docs/discovery/tender-pro-probe.md). Worker as-is не читает.
TENDER_PRO_COOKIES_FILE=./cookies.tender-pro.txt
# 1/true/yes — качать файлы score≥4 на том. 0 — kill switch, новые файлы не появляются.
DOWNLOAD_DOCS=0

# Postgres (compose). POSTGRES_PASSWORD обязателен, иначе контейнер db не стартует.
POSTGRES_USER=scout
POSTGRES_PASSWORD=
POSTGRES_DB=scout
# Для инструментов на хосте (psql, pytest). Compose публикует Postgres на **5433**.
# Если DATABASE_URL пуст, хост собирает DSN из POSTGRES_* → localhost:5433 (app/db/config.py).
# Внутри сети api ходит на `db:5432` (compose задаёт DATABASE_URL сам).
DATABASE_URL=
# Опционально: отдельная БД для pytest smoke (иначе тот же Postgres, только ряды qa_smoke_*).
SCOUT_TEST_DATABASE_URL=

# Две учётки Scout (bootstrap при пустой таблице users). Пароли не логируются.
SCOUT_DIGITAL_USERNAME=
SCOUT_DIGITAL_PASSWORD=
SCOUT_DIGITAL_DISPLAY=
SCOUT_DIRECTOR_USERNAME=
SCOUT_DIRECTOR_PASSWORD=
SCOUT_DIRECTOR_DISPLAY=
# HttpOnly cookie scout_session: 1 на HTTPS (P7), 0 на дев HTTP.
SCOUT_COOKIE_SECURE=0

# Том документов (P5.5). В контейнере — /data/docs.
SCOUT_DOCS_DIR=/data/docs
# AS-IS HTML на /legacy (не корень). 0 — выключить.
SCOUT_LEGACY_HTML=1

# Не используются в runbook v0 (на будущее)
ROSTENDER_USER=
ROSTENDER_PASSWORD=

# VPS SSH — не для compose. Значения только в локальном `.env.vps` (gitignore).
# Канон: docs/delivery/vps.md  Host 77.91.94.111  user root  alias tenders-ndt-vps
# SCOUT_VPS_PASSWORD=   # never here; never in git
