# Copy to .env and fill secrets locally. Never commit .env.

ROSTENDER_BASE_URL=https://rostender.info
ROSTENDER_COOKIES_FILE=./cookies.rostender.txt

SIBUR_COOKIES_FILE=./cookies.sibur.txt
SIBUR_BASE_URL=https://srm.sibur.ru
SIBUR_NWBC_NODE=0000000037
SIBUR_HEADLESS=1
SIBUR_USER=
SIBUR_PASSWORD=

ONLINECONTRACT_COOKIES_FILE=./cookies.onlinecontract.txt
ONLINECONTRACT_USER=
ONLINECONTRACT_PASSWORD=

TENDER_PRO_COOKIES_FILE=./cookies.tender-pro.txt

B2B_CENTER_USER=
B2B_CENTER_PASSWORD=
B2B_CENTER_COOKIES_FILE=./cookies.b2b-center.txt
# B2B_CENTER_BASE_URL=https://www.b2b-center.ru
RTS_ROSATOM_COOKIES_FILE=./cookies.rts-rosatom.txt
# RTS_ROSATOM_BASE_URL=https://www.rosatom.rts-tender.ru
ROSELTORG_USER=
ROSELTORG_PASSWORD=
ROSELTORG_COOKIES_FILE=./cookies.roseltorg.txt
# ROSELTORG_BASE_URL=https://www.roseltorg.ru
OILB2BCS_USER=
OILB2BCS_PASSWORD=
OILB2BCS_COOKIES_FILE=./cookies.oilb2bcs.txt
SEVERSTAL_USER=
SEVERSTAL_PASSWORD=
SEVERSTAL_COOKIES_FILE=./cookies.severstal.txt

# 1/true/yes — download lot files for L1–L3. 0 — kill switch.
DOWNLOAD_DOCS=0

# provod.ai key only in .env. Without it, AI review records ai_error.
PROVOD_API_KEY=
# PROVOD_BASE_URL=https://api.provod.ai
# PROVOD_MODEL_CHAIN=

# Postgres (compose). POSTGRES_PASSWORD is required.
POSTGRES_USER=scout
POSTGRES_PASSWORD=
POSTGRES_DB=scout
# Host tools (psql, pytest): compose publishes Postgres on 5433.
# Empty DATABASE_URL → localhost:5433 from POSTGRES_* (app/db/config.py).
DATABASE_URL=
SCOUT_TEST_DATABASE_URL=

# Scout bootstrap users (only when users table is empty). Passwords are not logged.
SCOUT_DIGITAL_USERNAME=
SCOUT_DIGITAL_PASSWORD=
SCOUT_DIGITAL_DISPLAY=
SCOUT_DIRECTOR_USERNAME=
SCOUT_DIRECTOR_PASSWORD=
SCOUT_DIRECTOR_DISPLAY=
# HttpOnly cookie scout_session: 1 on HTTPS, 0 on local HTTP.
SCOUT_COOKIE_SECURE=0

# Optional SMTP (legacy / emergency). Product notify uses Bitrix.
# SMTP_PORT: 465 = implicit SSL; 587 = STARTTLS when SMTP_TLS=1.
# Relays (if used): SMTP_RELAY_* / SCOUT_HTTP_RELAY_* — values only in .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
SMTP_RELAY_URL=
SMTP_RELAY_SECRET=
SCOUT_HTTP_RELAY_URL=
SCOUT_HTTP_RELAY_SECRET=
MAIL_OPS_TO=
MAIL_L1_TO=
MAIL_L1_CC=

# Documents volume (container path).
SCOUT_DOCS_DIR=/data/docs
# Legacy static HTML on /legacy. 0 — off.
SCOUT_LEGACY_HTML=1

ROSTENDER_USER=
ROSTENDER_PASSWORD=

# Bitrix24 incoming webhook (CRM lead + IM). Values only in .env / VPS sync.
BITRIX_WEBHOOK_URL=
BITRIX_SMOKE_USER_ID=
BITRIX_LEAD_SOURCE_ID=
BITRIX_CHAT_DIALOG_ID=
BITRIX_OPS_DIALOG_ID=
BITRIX_ASSIGNED_BY_ID=
# 1 = also ping lead chat; 0 = lead only
BITRIX_SEND_CHAT=1
SCOUT_PUBLIC_ORIGIN=https://tenders.ndtexam.ru

# VPS SSH is not for compose. Use local gitignored .env.vps (SCOUT_VPS_HOST / USER / PASSWORD).
